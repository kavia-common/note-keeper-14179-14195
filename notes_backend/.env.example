# Copy this file to .env and adjust values as needed.
# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
# Some orchestrations expect the backend to bind to 3001
BACKEND_PORT=3001
# PORT is used as a fallback; keep consistent with BACKEND_PORT when possible
PORT=3001

# OpenAPI docs prefix (default: /docs)
OPENAPI_URL_PREFIX=/docs

# API metadata
API_TITLE=Notes Backend API
API_VERSION=v1

# CORS allowed origins (comma-separated or * for all)
CORS_ORIGINS=*

# Database connection string (default: sqlite:///notes.db in current working directory)
# Examples:
#   SQLite: sqlite:///notes.db
#   Postgres: postgresql+psycopg2://user:password@host:5432/dbname
#   MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///notes.db
